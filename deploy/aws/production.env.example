# Copy to /etc/yangsebam/production.env and supply values. Never commit real values.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/yangsebam
DB_USERNAME=
DB_PASSWORD=
DB_TRUSTSTORE_URL=file:/etc/yangsebam/rds-truststore.p12
DB_TRUSTSTORE_PASSWORD=
AUTH_HMAC_SECRET=
PORT=8080
DB_POOL_SIZE=10
LEGAL_TERMS_VERSION=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_VERSION=
LEGAL_PRIVACY_URL=
RESET_URL=
RESET_SENDER=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SAFETY_ENDPOINT=
SAFETY_SERVICE_TOKEN=
